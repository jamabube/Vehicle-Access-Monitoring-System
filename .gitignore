# ---------------------------------------------------------------------------
# Project-root ignore rules. The Laravel app has its own .gitignore inside
# vams-webapp/ that already excludes .env, /vendor, /node_modules, *.log, etc.
# ---------------------------------------------------------------------------

# Never commit secrets (belt-and-suspenders; also ignored inside vams-webapp)
**/.env
**/.env.*
!**/.env.example

# Dependencies and build output (regenerated by composer / npm)
**/vendor/
**/node_modules/
**/public/build/
**/public/hot

# Archived old drafts and my temporary working files (large, not needed in git)
Archive/
_extracted/

# Local logs
logs/
*.log
compose-log.txt

# Office lock files and OS/editor cruft
~$*
.DS_Store
Thumbs.db
*.tmp

# Large media/capture files not needed in the repo (screen recordings, etc.)
*.mp4
*.m4a
*.mov
*.avi

# Embedded git repo (dev harness spec) — not part of the capstone upload
agent-spec/
